<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RR CAPITAL  ·  QUICK GLANCE"
        android:textColor="#CC785C"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="NET WORTH"
        android:textColor="#BDB8AF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/glance_net_worth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FAF9F5"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#33FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAFE LEFTOVER  ·  THIS MONTH"
        android:textColor="#BDB8AF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/glance_safe_leftover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FAF9F5"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
