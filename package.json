{
  "name": "financial-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-web.mjs",
    "lint": "oxlint",
    "test": "npm run test:dates && npm run test:offline && npm run test:edge-inputs && npm run test:reports && npm run test:dashboard-cash-flow && npm run test:dashboard-insights && npm run test:budgets && npm run test:calculators && npm run test:account-health && npm run test:feature-flag-cache && npm run test:route-registry && npm run test:perry && npm run test:financial-health && npm run test:safe-errors && npm run test:telegram && npm run test:password-policy && npm run test:group-split && npm run test:native-oauth && npm run test:ota-updates",
    "preview": "vite preview",
    "test:dates": "node --experimental-strip-types supabase/tests/finance_date.test.mjs",
    "test:offline": "node --experimental-strip-types supabase/tests/offline_ownership.test.mjs && node --experimental-strip-types supabase/tests/offline_error_messages.test.mjs",
    "test:edge-inputs": "node --experimental-strip-types supabase/tests/bounded_json.test.mjs && node --experimental-strip-types supabase/tests/receipt_payload.test.mjs",
    "test:reports": "node --experimental-strip-types supabase/tests/report_navigation.test.mjs",
    "test:dashboard-cash-flow": "node --experimental-strip-types supabase/tests/dashboard_cash_flow.test.mjs",
    "test:dashboard-insights": "node --experimental-strip-types supabase/tests/dashboard_insights_math.test.mjs",
    "test:budgets": "node --experimental-strip-types supabase/tests/budget_math.test.mjs",
    "test:calculators": "node --experimental-strip-types supabase/tests/calculator_math.test.mjs",
    "test:account-health": "node --experimental-strip-types supabase/tests/account_health_math.test.mjs",
    "test:feature-flag-cache": "node --experimental-strip-types supabase/tests/feature_flag_cache.test.mjs",
    "test:route-registry": "node --experimental-strip-types supabase/tests/route_registry.test.mjs",
    "test:perry": "node --experimental-strip-types supabase/functions/perry-summary/handler.test.mjs",
    "test:financial-health": "node --experimental-strip-types supabase/tests/financial_health_math.test.mjs",
    "test:safe-errors": "node --experimental-strip-types supabase/tests/safe_error_messages.test.mjs",
    "test:telegram": "node --experimental-strip-types supabase/tests/telegram_webhook_secret.test.mjs",
    "test:password-policy": "node --experimental-strip-types supabase/tests/password_policy.test.mjs",
    "test:group-split": "node --experimental-strip-types supabase/tests/group_split_math.test.mjs",
    "test:native-oauth": "node --experimental-strip-types supabase/tests/native_oauth_callback.test.mjs",
    "test:ota-version": "node scripts/otaVersion.test.mjs",
    "test:ota-updates": "node --experimental-strip-types scripts/otaUpdateResponse.test.mjs",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "test:e2e": "npm run typecheck:e2e && playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:assets": "node scripts/generate-android-icons.mjs",
    "android:package-release": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug && cd .. && node scripts/package-android-release.mjs",
    "build:web:deploy": "npm run build && node scripts/stage-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-updater": "^8.52.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^4.0.2",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@capgo/cli": "7.87.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1"
  }
}
